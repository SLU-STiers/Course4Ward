generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------- Enums ----------
enum Role {
  ADMIN
  PHYSICIAN
  NURSE
  CLAIMS_PROCESSOR

  @@map("role")
}

enum OrderType {
  ADMISSION
  DISCHARGE
  DEFAULT
  OBSERVATION

  @@map("order_type")
}

/// Kind of hospital encounter an admission record currently is.
/// EMERGENCY / OUTPATIENT -> OBSERVATION needs an OBSERVATION order,
/// any non-inpatient -> INPATIENT needs an ADMISSION order; the nurse
/// carries both out. See PatientsService.
/// Patient sex as recorded at registration (PhilHealth CF4 "Sex").
enum Sex {
  MALE
  FEMALE
  OTHER

  @@map("sex")
}

/// How the patient's care is covered, as recorded at registration.
enum InsuranceType {
  PHILHEALTH
  HMO
  PRIVATE
  NONE
  OTHER

  @@map("insurance_type")
}

enum PatientClass {
  EMERGENCY
  OUTPATIENT
  OBSERVATION
  INPATIENT

  @@map("patient_class")
}

enum OrderStatus {
  TO_ACCOMPLISH
  ONGOING
  FINISHED

  @@map("order_status")
}


enum OrderEnteredBy {
  PHYSICIAN
  NURSE_ON_BEHALF
}

enum SummaryStatus {
  DRAFT_AI
  DRAFT_EDITED
  APPROVED
}

enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}


enum ActionType {
  LOGIN
  LOGOUT
  ADD_NOTE
  CREATE_ORDER_NURSE
  CREATE_ORDER
  APPROVE_SUMMARY
  EDIT_SUMMARY
  REGENERATE_SUMMARY
  REQUEST_SUMMARY
  ADD_ACCOUNT
  EDIT_ACCOUNT
  DELETE_ACCOUNT
  REGISTER_PATIENT
  PATIENT_UPDATED
  PASSWORD_RESET
  CLAIM_CREATED
  CLAIM_PHYSICIAN_NOTIFIED
  CF4_GENERATED
  UPDATE_ORDER_STATUS
}

enum PhilHealthCF4Status {
  PENDING
  APPROVED
  REJECTED

  @@map("philhealth_cf4_status")
}

enum CommunicationChannel {
  SMS
  EMAIL
  CALL
  VERBAL
  OTHER
}

enum NotificationType {
  /// Claims processor asked the physician to review a summary again.
  REVIEW_REQUESTED
  GENERAL

  @@map("notification_type")
}

// ---------- Models ----------
model User {
  id                String   @id @default(uuid())
  userId            String   @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role
  isActive          Boolean  @default(true)
  mustResetPassword Boolean  @default(false)
  sessionVersion    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ordersAsPhysician          PhysicianOrder[]         @relation("OrderingPhysician")
  ordersAsEncoder            PhysicianOrder[]         @relation("EnteredBy")
  ordersExecuted             PhysicianOrder[]         @relation("ExecutedBy")
  notes                      PhysicianNote[]
  summariesValidated         CourseInWard[]           @relation("ApprovedBy")
  admissions                 PatientAdmission[]
  additionalAdmissions       AdmissionPhysician[]
  triagesRecorded            TriageAssessment[]       @relation("TriageRecordedBy")
  auditLogs                  AuditLog[]
  passwordResets             PasswordResetRequest[]
  notifications              Notification[]
  summaryRequestsAsPhysician SummaryApprovalRequest[] @relation("RequestedPhysician")
  summaryRequestsAsProcessor SummaryApprovalRequest[] @relation("RequestedProcessor")
  /// Wards a nurse works in; a nurse sees full patient details only there.
  wards                      NurseWard[]
  /// Wards / specialties a physician is assigned to.
  physicianWards              PhysicianWard[]

  @@map("users")
}

model UserIdCounter {
  role        Role @id
  nextNumber  Int  @default(1)

  @@map("user_id_counters")
}

model Patient {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  gender      Sex?
  dateOfBirth DateTime?
  contactNumber String?
  address       String?
  insurance     InsuranceType?
  /// The specific insurance when `insurance` is OTHER.
  insuranceOther String?
  religion      String?
  contactPersonName    String?
  contactPersonNumber  String?
  contactPersonAddress String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admissions    PatientAdmission[]
  notes         PhysicianNote[]
  coursesInWard CourseInWard[]

  @@map("patients")
}

model PatientAdmission {
  id                String    @id @default(uuid())
  admissionDate     DateTime
  dischargeDate     DateTime?
  patientClass      PatientClass @default(EMERGENCY)
  /// When the admission entered its current class (e.g. start of observation).
  classSince        DateTime     @default(now())
  initialAssessment String?
  patientId         String
  physicianId       String?      
  /// The ward room of an admitted patient; freed once the admission is discharged.
  roomId            String?
  patient           Patient @relation(fields: [patientId], references: [id])
  physician         User?   @relation(fields: [physicianId], references: [id])
  room              Room?   @relation(fields: [roomId], references: [id])
  orders PhysicianOrder[]
  additionalPhysicians AdmissionPhysician[]
  triage               TriageAssessment?

  @@index([roomId])
  @@map("patient_admissions")
}

/// A ward room. Occupied while an undischarged admission is assigned to it.
model Room {
  id         String   @id @default(uuid())
  number     String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  wardId     String?
  ward       Ward?    @relation(fields: [wardId], references: [id])

  admissions PatientAdmission[]

  @@index([wardId])
  @@map("rooms")
}

/// A nursing unit. A patient is in the ward of their room; a patient without
/// a room (outpatient, observation, not yet roomed) is in the one ward with
/// `holdsUnroomed` (Emergency) — at most one, enforced by a partial unique index.
model Ward {
  id            String   @id @default(uuid())
  name          String   @unique
  holdsUnroomed Boolean  @default(false)
  createdAt     DateTime @default(now())

  rooms  Room[]
  nurses NurseWard[]
  physicians PhysicianWard[]

  @@map("wards")
}

model PhysicianWard {
  physicianId String
  wardId      String
  physician   User @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  ward        Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@id([physicianId, wardId])
  @@index([wardId])
  @@map("physician_wards")
}

model NurseWard {
  nurseId String
  wardId  String
  nurse   User @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  ward    Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@id([nurseId, wardId])
  @@index([wardId])
  @@map("nurse_wards")
}

model TriageAssessment {
  id           String   @id @default(uuid())
  admissionId  String   @unique
  /// 5-level triage priority: 1 Resuscitation, 2 Emergent, 3 Urgent,
  /// 4 Less Urgent, 5 Non-Urgent. The migration adds a CHECK (1-5).
  triageLevel  Int?
  triageTime   String?
  heartRate    Int?
  respRate     Int?
  spo2         Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  temperature  Decimal? @db.Decimal(4, 1)
  painScore    Int?
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admission  PatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  recordedBy User?            @relation("TriageRecordedBy", fields: [recordedById], references: [id])

  @@map("triage_assessments")
}

model AdmissionPhysician {
  admissionId String
  physicianId String
  createdAt   DateTime @default(now())

  admission PatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  physician User             @relation(fields: [physicianId], references: [id])

  @@id([admissionId, physicianId])
  @@index([physicianId])
  @@map("admission_physicians")
}

model PhysicianOrder {
  id             String                      @id @default(uuid())
  orderContent   String
  type           OrderType                   @default(DEFAULT)
  status         OrderStatus                 @default(TO_ACCOMPLISH)
  nurseComment   String?                     
  executedById   String?                     
  executedAt     DateTime?                   
  dateCreated    DateTime                    @default(now())
  dateUpdated    DateTime?                   @updatedAt
  orderEmbedding Unsupported("vector(1024)")?
  admissionId    String
  orderedById    String
  encodedById    String
  enteredByRole  OrderEnteredBy              @default(PHYSICIAN)
  active         Boolean                     @default(true)

  communicationChannel CommunicationChannel?

  summarizationId String?

  admission  PatientAdmission @relation(fields: [admissionId], references: [id])
  orderedBy  User             @relation("OrderingPhysician", fields: [orderedById], references: [id])
  encodedBy  User             @relation("EnteredBy", fields: [encodedById], references: [id])
  executedBy User?            @relation("ExecutedBy", fields: [executedById], references: [id])
  summary    CourseInWard?    @relation(fields: [summarizationId], references: [id])

  @@index([admissionId, dateCreated])
  @@index([executedById])   
  @@map("physician_orders")
}

model PhysicianNote {
  id          String    @id @default(uuid())
  notesArray  String
  physicianId String
  patientId   String
  createdAt   DateTime  @default(now())
  reminderAt  DateTime?

  physician User    @relation(fields: [physicianId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])

  @@index([physicianId])
  @@map("physician_notes")
}

model CourseInWard {
  id              String               @id @default(uuid())
  summaryContent  String
  summaryDate     DateTime             @default(now())
  approvedStatus  Boolean?
  status          SummaryStatus        @default(DRAFT_AI)
  validatorId     String?
  validatedAt     DateTime?
  patientId       String

  philhealthCf4Status    PhilHealthCF4Status @default(PENDING)   
  philhealthCf4DecidedAt DateTime?                               

  patient    Patient                  @relation(fields: [patientId], references: [id])
  approvedBy User?                    @relation("ApprovedBy", fields: [validatorId], references: [id])
  orders     PhysicianOrder[]
  requests   SummaryApprovalRequest[]
  versions   SummaryVersion[]

  @@map("courses_in_ward")
}

/// Earlier text of a Course in the Ward, kept when it is regenerated or edited
/// so the physician can restore it. Capped per summary; cleared on approval.
model SummaryVersion {
  id        String        @id @default(uuid())
  summaryId String
  content   String
  /// The status the text had (DRAFT_AI, DRAFT_EDITED or APPROVED).
  source    SummaryStatus
  /// When this text was replaced.
  createdAt DateTime      @default(now())

  summary CourseInWard @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId, createdAt])
  @@map("summary_versions")
}

model SummaryApprovalRequest {
  id          String   @id @default(uuid())
  physicianId String
  processorId String
  summaryId   String
  requestedAt DateTime @default(now())
  status      String   @default("PENDING")

  physician User         @relation("RequestedPhysician", fields: [physicianId], references: [id])
  processor User         @relation("RequestedProcessor", fields: [processorId], references: [id])
  summary   CourseInWard @relation(fields: [summaryId], references: [id])

  @@map("summary_approval_requests")
}

model PasswordResetRequest {
  id          String      @id @default(uuid())
  userId      String
  ipAddress   String?
  token       String      @unique
  temporaryPassword String?
  requestedAt DateTime    @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?
  status      ResetStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_requests")
}

model AuditLog {
  id        String     @id @default(uuid())
  timeStamp DateTime   @default(now())
  action    ActionType
  userId    String

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

/// In-app notification for one user, rendered by the header bell
/// (`components/layout/NotificationBell.tsx`) and its panel.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  /// The summary approval request this notification points at, when any.
  requestId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  /// Set when the user clears the bell. The row leaves the inbox (and the
  /// badge) but stays visible in the notification history.
  clearedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, clearedAt])
  @@index([userId, createdAt])
  @@map("notifications")
}