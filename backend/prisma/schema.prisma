generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------- Enums ----------
enum Role {
  PHYSICIAN
  NURSE
  CLAIMS_PROCESSOR
  ADMIN
}

enum OrderType {
  MEDICATION
  ADMISSION
  DISCHARGE
  DIAGNOSTIC
  OTHER
}

enum OrderEnteredBy {
  PHYSICIAN
  NURSE_ON_BEHALF
}

enum SummaryStatus {
  DRAFT_AI
  DRAFT_EDITED
  APPROVED
}

enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ActionType {
  LOGIN
  LOGOUT
  ADD_NOTE
  CREATE_ORDER_NURSE
  CREATE_ORDER
  APPROVE_SUMMARY
  EDIT_SUMMARY
  REGENERATE_SUMMARY
  REQUEST_SUMMARY
  ADD_ACCOUNT
  EDIT_ACCOUNT
  DELETE_ACCOUNT
  REGISTER_PATIENT
}

// ---------- Models ----------
model User {
  id                String   @id @default(uuid())
  userId            String   @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role
  isActive          Boolean  @default(true)
  mustResetPassword Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ordersAsPhysician          PhysicianOrder[]         @relation("OrderingPhysician")
  ordersAsEncoder            PhysicianOrder[]         @relation("EnteredBy")
  notes                      PhysicianNote[]
  summariesValidated         CourseInWard[]           @relation("ApprovedBy")
  admissions                 PatientAdmission[]
  auditLogs                  AuditLog[]
  passwordResets             PasswordResetRequest[]
  summaryRequestsAsPhysician SummaryApprovalRequest[] @relation("RequestedPhysician")
  summaryRequestsAsProcessor SummaryApprovalRequest[] @relation("RequestedProcessor")

  @@map("users")
}

model Patient {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  gender      String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admissions    PatientAdmission[]
  notes         PhysicianNote[]
  coursesInWard CourseInWard[]

  @@map("patients")
}

model PatientAdmission {
  id            String    @id @default(uuid())
  admissionDate DateTime
  dischargeDate DateTime?
  patientId     String
  physicianId   String

  patient   Patient @relation(fields: [patientId], references: [id])
  physician User    @relation(fields: [physicianId], references: [id])

  orders PhysicianOrder[]

  @@map("patient_admissions")
}

model PhysicianOrder {
  id             String                      @id @default(uuid())
  orderContent   String
  dateCreated    DateTime                    @default(now())
  dateUpdated    DateTime?                   @updatedAt
  orderEmbedding Unsupported("vector(768)")?
  admissionId    String
  orderedById    String
  encodedById    String
  enteredByRole  OrderEnteredBy              @default(PHYSICIAN)
  active         Boolean                     @default(true)

  summarizationId String?

  admission PatientAdmission @relation(fields: [admissionId], references: [id])
  orderedBy User             @relation("OrderingPhysician", fields: [orderedById], references: [id])
  encodedBy User             @relation("EnteredBy", fields: [encodedById], references: [id])
  summary   CourseInWard?    @relation(fields: [summarizationId], references: [id])

  @@index([admissionId, dateCreated])
  @@map("physician_orders")
}

model PhysicianNote {
  id          String    @id @default(uuid())
  notesArray  String
  physicianId String
  patientId   String
  createdAt   DateTime  @default(now())
  reminderAt  DateTime?

  physician User    @relation(fields: [physicianId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])

  @@map("physician_notes")
}

model CourseInWard {
  id             String        @id @default(uuid())
  summaryContent String
  summaryDate    DateTime      @default(now())
  approvedStatus Boolean?
  status         SummaryStatus @default(DRAFT_AI)
  validatorId    String?
  validatedAt    DateTime?
  patientId      String

  patient    Patient                  @relation(fields: [patientId], references: [id])
  approvedBy User?                    @relation("ApprovedBy", fields: [validatorId], references: [id])
  orders     PhysicianOrder[]
  requests   SummaryApprovalRequest[]

  @@map("courses_in_ward")
}

model SummaryApprovalRequest {
  id          String   @id @default(uuid())
  physicianId String
  processorId String
  summaryId   String
  requestedAt DateTime @default(now())
  status      String   @default("PENDING")

  physician User         @relation("RequestedPhysician", fields: [physicianId], references: [id])
  processor User         @relation("RequestedProcessor", fields: [processorId], references: [id])
  summary   CourseInWard @relation(fields: [summaryId], references: [id])

  @@map("summary_approval_requests")
}

model PasswordResetRequest {
  id          String      @id @default(uuid())
  userId      String
  token       String      @unique
  requestedAt DateTime    @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?
  status      ResetStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_requests")
}

model AuditLog {
  id        String     @id @default(uuid())
  timeStamp DateTime   @default(now())
  action    ActionType
  userId    String

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}