// schema2.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  PHYSICIAN
  NURSE
  CLAIMS_PROCESSOR

  @@map("role")
}

enum Action {
  LOGIN
  LOGOUT
  ADD_NOTE
  CREATE_ORDER_NURSE
  CREATE_ORDER
  APPROVE_SUMMARIZATION
  EDIT_SUMMARIZATION
  REGENERATE_SUMMARIZATION
  REQUEST_SUMMARIZATION_APPROVAL
  ADD_ACCOUNT
  DELETE_ACCOUNT
  REGISTER_PATIENT

  @@map("action")
}

model USER {
  userID     String   @id @default(uuid())
  first_name String   @db.VarChar(40)
  last_name  String   @db.VarChar(40)
  password   String // bcrypt hash (60 chars); never store plaintext
  role       Role
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  logs LOGS[]

  password_reset_requests PASSWORD_RESET_REQUEST[]

  notes PHYSICIAN_NOTES[]

  admissions PATIENT_ADMISSION[] @relation("AttendingPhysician")

  orders_placed  ORDERS[] @relation("OrderedBy")
  orders_encoded ORDERS[] @relation("EncodedBy")

  validated_summaries SUMMARYED_COURSE_IN_THE_WARD[] @relation("ValidatingPhysician")

  approval_requests_as_physician SUMMARY_APPROVAL_REQUEST[] @relation("RequestedPhysician")
  approval_requests_as_processor SUMMARY_APPROVAL_REQUEST[] @relation("RequestingProcessor")

  @@map("users")
}

model PATIENT {
  patientID  String   @id @default(uuid())
  first_name String   @db.VarChar(40)
  last_name  String   @db.VarChar(40)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admissions PATIENT_ADMISSION[]

  @@map("patients")
}

model PATIENT_ADMISSION {
  admissionID    String    @id @default(uuid())
  discharge_date DateTime?
  admission_date DateTime  @default(now())
  patientID      String
  physicianID    String

  patient PATIENT @relation(fields: [patientID], references: [patientID], onDelete: Restrict)

  attending_physician USER @relation("AttendingPhysician", fields: [physicianID], references: [userID], onDelete: Restrict)

  orders             ORDERS[]
  physician_notes    PHYSICIAN_NOTES[]
  summarized_courses SUMMARYED_COURSE_IN_THE_WARD[]

  @@index([patientID])
  @@index([physicianID])
  @@index([admission_date])
  @@map("patient_admissions")
}

model ORDERS {
  orderID         String                      @id @default(uuid())
  order_content   String
  date_created    DateTime                    @default(now())
  date_updated    DateTime                    @updatedAt
  order_embedding Unsupported("vector(768)")?
  admissionID     String
  ordered_by      String
  encoded_by      String
  summarizationID String?

  admission PATIENT_ADMISSION @relation(fields: [admissionID], references: [admissionID], onDelete: Restrict)

  ordering_user USER @relation("OrderedBy", fields: [ordered_by], references: [userID], onDelete: Restrict)
  encoding_user USER @relation("EncodedBy", fields: [encoded_by], references: [userID], onDelete: Restrict)

  summary SUMMARYED_COURSE_IN_THE_WARD? @relation("SummarizationForOrders", fields: [summarizationID], references: [summarizationID], onDelete: Restrict)

  @@index([admissionID])
  @@index([ordered_by])
  @@index([encoded_by])
  @@index([summarizationID])
  @@index([date_created])
  @@index([admissionID, date_created])
  @@map("orders")
}

model PHYSICIAN_NOTES {
  notesID     String   @id @default(uuid())
  notes_array String[]
  physicianID String
  admissionID String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician USER @relation(fields: [physicianID], references: [userID], onDelete: Restrict)

  admission PATIENT_ADMISSION? @relation(fields: [admissionID], references: [admissionID], onDelete: Restrict)

  @@index([physicianID])
  @@index([admissionID])
  @@map("physician_notes")
}

model SUMMARYED_COURSE_IN_THE_WARD {
  summarizationID String   @id @default(uuid())
  summary_content String
  summary_date    DateTime @default(now())
  approve_status  Boolean  @default(false)
  validator_id    String?
  admissionID     String

  admission PATIENT_ADMISSION @relation(fields: [admissionID], references: [admissionID], onDelete: Restrict)

  validator USER? @relation("ValidatingPhysician", fields: [validator_id], references: [userID], onDelete: Restrict)

  orders            ORDERS[]                   @relation("SummarizationForOrders")
  approval_requests SUMMARY_APPROVAL_REQUEST[] @relation("RequestSummaryForApproval")

  @@index([admissionID])
  @@index([validator_id])
  @@index([summary_date])
  @@map("summarized_courses_in_ward")
}

model SUMMARY_APPROVAL_REQUEST {
  approvalID  String    @id @default(uuid())
  physicianID String
  processorID String
  summaryID   String
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  requested_physician USER @relation("RequestedPhysician", fields: [physicianID], references: [userID], onDelete: Restrict)

  requesting_processor USER @relation("RequestingProcessor", fields: [processorID], references: [userID], onDelete: Restrict)

  summary SUMMARYED_COURSE_IN_THE_WARD @relation("RequestSummaryForApproval", fields: [summaryID], references: [summarizationID], onDelete: Restrict)

  @@index([physicianID])
  @@index([processorID])
  @@index([summaryID])
  @@map("summary_approval_requests")
}

model LOGS {
  logID      String   @id @default(uuid())
  time_stamp DateTime @default(now())
  action     Action
  userID     String?
  metadata   Json?
  ipAddress  String?

  user USER? @relation(fields: [userID], references: [userID], onDelete: SetNull)

  @@index([userID])
  @@index([time_stamp])
  @@map("logs")
}

model PASSWORD_RESET_REQUEST {
  passresetID String    @id @default(uuid())
  userID      String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  user USER @relation(fields: [userID], references: [userID], onDelete: Restrict)

  @@index([userID])
  @@map("password_reset_requests")
}
